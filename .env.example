# P2 — FINDER Core (instancia San Juan)
# Topología A: estas variables viven SOLO en el server de P1. Nunca exponerlas al cliente
# (no usar prefijo NEXT_PUBLIC_).

# URL base de P2 SIN /api/v1 (el cliente lo agrega). Instancia de prueba: puerto 8001.
# Si se deja vacío, P1 sirve los mocks de /mocks (modo demo).
P2_BASE_URL=http://localhost:8001

# API key del portal (header X-API-Key). Vacía en P2 = auth apagada (solo desarrollo).
P2_API_KEY=

# auto (default) | live | mock
#  - auto: usa P2 si hay P2_BASE_URL; ante fallo de CONEXIÓN (red) cae a mocks con warning.
#  - live: solo P2; los errores se propagan.
#  - mock: siempre mocks, aunque haya P2_BASE_URL.
P2_MODE=auto

# --- MVP beta (2026-09-05) ---
# WhatsApp para inmobiliarias/dueños que quieran publicar (botón "Publicá tu propiedad").
# Solo dígitos con código de país, ej. 5492645550000. Vacío = el botón no se muestra.
CONTACT_WHATSAPP=
# Texto prellenado del mensaje (opcional).
# CONTACT_WHATSAPP_TEXT=Hola, quiero publicar propiedades en paradisofinder.com

# --- Cierre QA 7/9 (2026-09-14) ---
# Origen público del sitio: canonical, Open Graph, sitemap y el link del detalle en el
# mensaje de WhatsApp del botón "Consultar". En local: http://localhost:3000.
SITE_URL=http://localhost:3000
# Token del tablero interno de embudo (/interno/embudo?token=…). Vacío = solo en desarrollo.
METRICS_TOKEN=

# Log propio de eventos de uso (consulta → resultados → navegación): un JSONL por día
# en este directorio (relativo al cwd del server). Vacío = solo stdout. Se lee con
# `node scripts/events-report.mjs`.
EVENTS_LOG_DIR=logs

# --- Análisis de inversión (2026-11-02, docs/DECISION_2026-11-02_analisis-inversion.md) ---
# Interruptor del segundo canal de Invertir (P2 `POST /search/invest`). 0|false|off = apagado:
# Invertir funciona como siempre (cards ordenadas por rentabilidad), sin panel. Default: encendido.
# INVEST_ANALYSIS_ENABLED=1
# Cupos de P1 (en memoria del proceso): análisis por visitante (y por IP) en la ventana, y tope
# diario UTC. Un `skip` de P2 (pregunta simple) no cuenta. 0 = sin ese cupo.
# INVEST_QUOTA_PER_VISITOR=5
# INVEST_QUOTA_WINDOW_MIN=10
# INVEST_DAILY_MAX=300
# Caché de respuestas completas por consulta normalizada, en minutos (0 = sin caché).
# INVEST_CACHE_TTL_MIN=15

# --- Stage / producción (Railway) — NO acá: cargar en Service → Variables. Ver docs/DEPLOY_RAILWAY.md ---
# P2_BASE_URL=http://paradisofinder-core.railway.internal:8000     (red privada: mismo proyecto y entorno que P2; http://, puerto 8000)
# P2_BASE_URL=https://paradisofinder-core-staging.up.railway.app   (plan B: URL pública del stage de P2)
# P2_API_KEY=<PORTAL_API_KEY del entorno stage de P2>
# P2_MODE=live                (ya viene en el Dockerfile)
# EVENTS_LOG_DIR=/data/logs   (ya viene en el Dockerfile; montar un volumen en /data)
# CONTACT_WHATSAPP=549264XXXXXXX

# --- CI/CD local (docs/CI_CD.md) — secretos del smoke de stage: SÍ en .env.local (las URLs van en .ci/config) ---
# STAGE_P2_API_KEY=           (la PORTAL_API_KEY del stage de P2, para cruzar total_matches)
# RAILWAY_TOKEN=              (solo con CD_STAGE_DEPLOY=railway)
